<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>vn.ots.qc.consumer.template</groupId>
    <artifactId>mobile-consumer-tests</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Appium Consumer Test Template</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <appium.framework.version>3.0.1-SNAPSHOT</appium.framework.version>
        <testng.version>7.12.0</testng.version>
        <compiler.version>3.15.0</compiler.version>
        <surefire.version>3.5.6</surefire.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>vn.ots.qc</groupId>
            <artifactId>framework-testng</artifactId>
            <version>${appium.framework.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>gitlab-registry</id>
            <activation>
                <property><name>appium.framework.repository.url</name></property>
            </activation>
            <repositories>
                <repository>
                    <id>appium-framework-registry</id>
                    <url>${appium.framework.repository.url}</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.version}</version>
                <configuration><release>${maven.compiler.release}</release><parameters>true</parameters></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration><failIfNoTests>true</failIfNoTests></configuration>
            </plugin>
        </plugins>
    </build>
</project>
